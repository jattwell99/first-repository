# Copy to .env and adjust for your environment.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database — matches docker-compose.yml `db` service.
# When unset, the project falls back to a local SQLite file (db.sqlite3),
# which is handy for quick checks without Postgres.
DATABASE_URL=postgres://ukeconomy:ukeconomy@127.0.0.1:5432/ukeconomy
